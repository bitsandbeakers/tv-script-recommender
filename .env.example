# Copy to .env and fill in your values

# LLM provider (via LiteLLM — pick one)
# Local Ollama (free, no key needed):
TVR_LLM_MODEL=ollama/mistral
TVR_LLM_API_BASE=http://localhost:11434
TVR_LLM_API_KEY=
# Other options:
# TVR_LLM_MODEL=groq/llama-3.1-8b-instant     # free tier at console.groq.com
# TVR_LLM_MODEL=gemini/gemini-1.5-flash        # free tier at aistudio.google.com
# TVR_LLM_MODEL=openai/gpt-4o-mini             # OpenAI
# TVR_LLM_MODEL=anthropic/claude-haiku-4-5     # Anthropic

TVR_OPENSUBTITLES_API_KEY=
TVR_OPENSUBTITLES_USERNAME=
TVR_OPENSUBTITLES_PASSWORD=
TVR_TMDB_API_KEY=your-tmdb-api-key
TVR_TMDB_READ_TOKEN=your-tmdb-read-access-token
TVR_TVDB_API_KEY=your-tvdb-api-key
TVR_DEBUG=true
